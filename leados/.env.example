# Copy to .env and run with: node --env-file=.env server.js
PORT=3000

# Claude API: prep questions. Without a key, LeadOS uses its built-in question library.
ANTHROPIC_API_KEY=
# LEADOS_MODEL=claude-opus-5-5
# LEADOS_AI=off

# Google Calendar (read-only). Without these, only the demo week is available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# ORG_CONTEXT_PATH=./config/org-context.json
# LEADOS_DB=./data/leados.db
